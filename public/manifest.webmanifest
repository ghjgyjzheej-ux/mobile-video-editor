* {
  box-sizing: border-box;
}

:root {
  color-scheme: dark;
  --bg: #07111d;
  --panel: rgba(15, 23, 42, 0.82);
  --panel-strong: rgba(15, 23, 42, 0.96);
  --line: rgba(148, 163, 184, 0.18);
  --text: #e5eefb;
  --muted: #94a3b8;
  --accent: #8b5cf6;
  --accent-2: #22d3ee;
  --shadow: 0 20px 50px rgba(2, 6, 23, 0.46);
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
  font-family: Inter, 'Segoe UI', sans-serif;
  background:
    radial-gradient(circle at top, rgba(139, 92, 246, 0.18), transparent 28%),
    linear-gradient(180deg, #020817, var(--bg));
  color: var(--text);
}

body {
  min-height: 100vh;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  max-width: 480px;
  margin: 0 auto;
  padding: 18px 16px 32px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
}

.eyebrow {
  margin: 0 0 4px;
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 0.14em;
}

h1,
h2,
h3,
p {
  margin: 0;
}

h1 {
  font-size: clamp(1.8rem, 4vw, 2.4rem);
  line-height: 1.1;
}

.preview-card,
.panel-block,
.timeline-wrap {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 24px;
  box-shadow: var(--shadow);
}

.preview-card {
  padding: 14px;
}

.project-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 12px;
}

.pill,
.chip {
  display: inline-flex;
  align-items: center;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 11px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.pill {
  background: rgba(148, 163, 184, 0.08);
  color: var(--muted);
  border: 1px solid var(--line);
}

.video-stage {
  position: relative;
  height: 300px;
  border-radius: 22px;
  overflow: hidden;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
}

.video-stage::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(2, 6, 23, 0.1), rgba(2, 6, 23, 0.42)),
    repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.06),
      rgba(255, 255, 255, 0.06) 2px,
      transparent 2px,
      transparent 6px
    );
}

.video-content {
  position: absolute;
  left: 18px;
  right: 18px;
  bottom: 18px;
  z-index: 1;
}

.video-content h2 {
  font-size: clamp(1.8rem, 7vw, 2.6rem);
  margin: 10px 0 6px;
}

.video-content p {
  color: rgba(255, 255, 255, 0.82);
}

.chip-dark {
  background: rgba(2, 6, 23, 0.42);
  border: 1px solid rgba(255, 255, 255, 0.14);
  color: white;
}

.preview-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-top: 14px;
}

.muted-label {
  color: var(--muted);
  font-size: 11px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin-bottom: 5px;
}

.primary-btn,
.soft-btn,
.mini-btn,
.tag {
  border: none;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.primary-btn,
.soft-btn {
  border-radius: 12px;
  padding: 10px 14px;
  font-weight: 700;
}

.primary-btn {
  background: linear-gradient(135deg, var(--accent), #7c3aed);
  color: white;
  box-shadow: 0 12px 24px rgba(124, 58, 237, 0.35);
}

.soft-btn {
  background: rgba(148, 163, 184, 0.08);
  color: var(--text);
  border: 1px solid var(--line);
}

.inspector {
  display: grid;
  gap: 12px;
  margin-top: 16px;
}

.panel-block {
  padding: 14px;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}

.panel-header h3 {
  font-size: 0.98rem;
}

.mini-btn {
  background: rgba(148, 163, 184, 0.08);
  border: 1px solid var(--line);
  color: var(--text);
  border-radius: 10px;
  padding: 8px 10px;
  font-size: 12px;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.tag {
  background: rgba(148, 163, 184, 0.08);
  color: var(--text);
  border: 1px solid transparent;
  border-radius: 999px;
  padding: 9px 12px;
}

.tag.active {
  background: rgba(59, 130, 246, 0.14);
  border-color: rgba(96, 165, 250, 0.4);
  color: #dbeafe;
}

.slider-block input[type='range'] {
  width: 100%;
  accent-color: #8b5cf6;
}

.timeline-wrap {
  margin-top: 16px;
  padding: 14px;
}

.timeline-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.timeline {
  display: grid;
  gap: 10px;
}

.clip-item {
  display: grid;
  grid-template-columns: 72px 1fr auto;
  gap: 12px;
  width: 100%;
  background: rgba(15, 23, 42, 0.7);
  color: var(--text);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 8px;
  text-align: left;
}

.clip-item.selected {
  border-color: rgba(34, 211, 238, 0.7);
  box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.16);
}

.clip-visual {
  height: 62px;
  border-radius: 12px;
  background: linear-gradient(135deg, #fbbf24, #ef4444);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
}

.clip-copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
}

.clip-copy strong {
  font-size: 0.98rem;
}

.clip-copy span,
.clip-meta {
  color: var(--muted);
  font-size: 12px;
}

.clip-meta {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
  gap: 6px;
}

.primary-btn:hover,
.soft-btn:hover,
.mini-btn:hover,
.tag:hover,
.clip-item:hover {
  transform: translateY(-1px);
}

@media (max-width: 420px) {
  .app-shell {
    padding-left: 12px;
    padding-right: 12px;
  }

  .video-stage {
    height: 270px;
  }

  .clip-item {
    grid-template-columns: 64px 1fr;
  }

  .clip-meta {
    grid-column: 2;
    align-items: flex-start;
  }
}
